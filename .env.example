# .env.example - Configuración de Daily Digest con Gemini y ntfy
# Copia este archivo a .env y asigna tu API Key gratuita de Google AI Studio

# 1. Tu API Key de Google Gemini (Gratis en https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Modelo Flash del Free Tier de Google
GEMINI_MODEL=gemini-3.5-flash

# 3. Notificaciones push con ntfy
NTFY_TOPIC=daily-digest-thefastag
SITE_URL=https://thefastag.github.io/daily-digest/
