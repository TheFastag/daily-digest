# .env.example - Configuración de Daily Digest con Gemini
# Copia este archivo a .env y asigna tu API Key gratuita de Google AI Studio

# 1. Tu API Key de Google Gemini (Gratis en https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Modelo Flash del Free Tier de Google
# Modelos disponibles: gemini-3.5-flash (recomendado), gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.5-flash

